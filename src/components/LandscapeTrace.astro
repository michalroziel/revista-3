---
// Line art traced from the photo in Inkscape, exported as a 1-bit transparent PNG.
// It's used as a mask over currentColor, so it follows the light/dark theme.
import traceMask from '../assets/zeitweilig-michal-trace.png';

interface Props {
  caption?: string;
  class?: string;
}

const { caption = '', class: className = '' } = Astro.props;
---

<figure class={`landscape-trace not-prose ${className}`.trim()} data-landscape-trace>
  <div class="landscape-trace__reveal">
    <div
      class="landscape-trace__art"
      style={`--trace-mask: url("${traceMask.src}");`}
      aria-hidden="true"
    >
      {/* Invisible copy that gives the box its size. The body is a wrapping
          flex column, which measures an aspect-ratio box as 0px tall. */}
      <img
        class="landscape-trace__sizer"
        src={traceMask.src}
        width={traceMask.width}
        height={traceMask.height}
        alt=""
      />
    </div>
  </div>
  {caption && <figcaption class="landscape-trace__caption">{caption}</figcaption>}
</figure>

<script is:inline>
  (() => {
    const setup = () => {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      if (!('IntersectionObserver' in window)) return;

      // Without this attribute (no JS, reduced motion) the drawing is simply shown.
      document.querySelectorAll('[data-landscape-trace]:not([data-trace-armed])').forEach(root => {
        root.dataset.traceArmed = '';

        const observer = new IntersectionObserver(
          entries => {
            if (!entries.some(entry => entry.isIntersecting)) return;
            root.classList.add('is-visible');
            observer.disconnect();
          },
          { threshold: 0.2 }
        );

        observer.observe(root);
      });
    };

    if (!window.__landscapeTraceSetupBound) {
      window.__landscapeTraceSetupBound = true;
      document.addEventListener('astro:page-load', setup);
    }

    setup();
  })();
</script>

<style>
  .landscape-trace {
    margin: 2.5rem 0 3rem;
    color: inherit;
  }

  .landscape-trace__art {
    width: 100%;
    background-color: currentColor;
    -webkit-mask: var(--trace-mask) center / contain no-repeat;
    mask: var(--trace-mask) center / contain no-repeat;
  }

  .landscape-trace__sizer {
    display: block;
    width: 100%;
    height: auto;
    visibility: hidden;
  }

  /* A soft diagonal edge sweeps left to right: the gradient is 3x the
     element's width, and sliding it across uncovers the drawing. */
  .landscape-trace__reveal {
    -webkit-mask-image: linear-gradient(100deg, #000 40%, transparent 60%);
    mask-image: linear-gradient(100deg, #000 40%, transparent 60%);
    -webkit-mask-size: 300% 100%;
    mask-size: 300% 100%;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-position: 0 0;
    mask-position: 0 0;
  }

  .landscape-trace[data-trace-armed] .landscape-trace__reveal {
    -webkit-mask-position: 100% 0;
    mask-position: 100% 0;
    transition:
      -webkit-mask-position 3.5s cubic-bezier(0.45, 0, 0.25, 1),
      mask-position 3.5s cubic-bezier(0.45, 0, 0.25, 1);
  }

  .landscape-trace[data-trace-armed].is-visible .landscape-trace__reveal {
    -webkit-mask-position: 0 0;
    mask-position: 0 0;
  }

  .landscape-trace__caption {
    margin-top: 0.75rem;
    font-family: var(--font-overpass-mono), 'Overpass Mono', monospace;
    font-size: 0.88rem;
    letter-spacing: 0.08em;
    opacity: 0.6;
    line-height: 1.5;
  }
</style>
