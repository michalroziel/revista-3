---
import '../styles/MasonryLayout.css';
import { cloudinary, isCloudinary } from '../utils/cloudinary';
const { images } = Astro.props;
const thumbWidths = [400, 800, 1200];
const imageAssets = images.map(image =>
  image
    ? {
        src: cloudinary(image.src, { width: 800 }),
        srcset: isCloudinary(image.src)
          ? thumbWidths.map(w => `${cloudinary(image.src, { width: w })} ${w}w`).join(', ')
          : undefined,
        // full-size view in the lightbox
        href: cloudinary(image.src, { width: 2400 }),
        alt: image.alt,
      }
    : null
);
---

<div class="masonry not-prose">
  {
    imageAssets.map((imageAsset, index) =>
      imageAsset ? (
        <div
          key={index}
          class="image-container"
          id="gallery"
          style={`--stagger-index: ${index}`}
        >
          <a href={imageAsset.href} class="image-link glightbox">
            <img
              src={imageAsset.src}
              srcset={imageAsset.srcset}
              sizes="(max-width: 768px) 50vw, 400px"
              alt={imageAsset.alt}
              loading="lazy"
              decoding="async"
              width="3840"
              height="2160"
              class="image"
            />
          </a>
        </div>
      ) : null
    )
  }
</div>

<script src="../scripts/lightbox.js"></script>

<style>
  .image-container {
    opacity: 0;
    transform: translateY(20px);
    animation: slideInUp 0.6s ease-out forwards;
    animation-delay: calc(var(--stagger-index) * 80ms);
  }

  @keyframes slideInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
