---
import { cloudinary } from '../utils/cloudinary';
import {
  HOME,
  SIZE,
  facing,
  graticule,
  land,
  pathFor,
  projection,
  sphere,
  type LngLat,
} from '../scripts/globe';

export interface Place {
  id: string;
  title: string;
  url: string;
  collection: string;
  place: string;
  lat: number;
  lng: number;
  image?: { src: string; positionx?: string; positiony?: string };
  // [lat, lng] waypoints of the voyage, in order
  route?: [number, number][];
  pubDate: Date;
}

interface Props {
  places: Place[];
}

const { places } = Astro.props;

// The globe at its starting view, drawn at build time. It's what shows before the
// script takes over, and all that shows without JavaScript.
const path = pathFor(HOME);
const project = projection(HOME);

const formatCoord = (value: number, positive: string, negative: string) =>
  `${Math.abs(value).toFixed(2)}°${value >= 0 ? positive : negative}`;

// north to south, so the numbering reads down the globe
const pins = [...places]
  .sort((a, b) => b.lat - a.lat)
  .map((place, index) => {
    const at: LngLat = [place.lng, place.lat];
    const [x, y] = project(at) ?? [0, 0];
    const left = (x / SIZE) * 100;
    const top = (y / SIZE) * 100;
    return {
      ...place,
      number: String(index + 1).padStart(2, '0'),
      left,
      top,
      hidden: !facing(HOME, at),
      // open the preview card towards the middle of the globe so it stays on screen
      flipX: left > 60,
      flipY: top > 55,
      coords: `${formatCoord(place.lat, 'N', 'S')} ${formatCoord(place.lng, 'E', 'W')}`,
      cardImage: place.image && cloudinary(place.image.src, { width: 480 }),
      thumbnail: place.image && cloudinary(place.image.src, { width: 192 }),
      // keep the focal point the post's hero image uses
      focus: `object-position: ${place.image?.positionx ?? '50%'} ${place.image?.positiony ?? '50%'}`,
      kind: place.collection.replace('_', ' '),
      year: place.pubDate.getFullYear(),
    };
  });

const routes = places
  .filter(place => place.route)
  .map(place => ({
    id: place.id,
    coordinates: place.route!.map(([lat, lng]) => [lng, lat] as LngLat),
  }));
---

<figure class="photo-map not-prose" data-photo-map>
  <div class="photo-map__globe">
    <div
      class="photo-map__stage"
      data-stage
      tabindex="0"
      role="region"
      aria-label={`Globe with ${pins.length} places where these photographs were taken. Drag or use the arrow keys to turn it, plus and minus to zoom.`}
    >
      <svg class="photo-map__svg" viewBox={`0 0 ${SIZE} ${SIZE}`} aria-hidden="true">
        <defs>
          <radialGradient id="photo-map-shade" cx="50%" cy="50%" r="50%">
            <stop offset="72%" stop-color="currentColor" stop-opacity="0"></stop>
            <stop offset="100%" stop-color="currentColor" stop-opacity="0.08"></stop>
          </radialGradient>
        </defs>
        <path class="photo-map__shade" d={path(sphere)} data-sphere></path>
        <path class="photo-map__graticule" d={path(graticule)} data-graticule></path>
        <path class="photo-map__land" d={path(land)} data-land></path>
        {
          routes.map(route => (
            <path
              class="photo-map__route"
              d={path({ type: 'LineString', coordinates: route.coordinates }) ?? ''}
              data-route={JSON.stringify(route.coordinates)}
            />
          ))
        }
        {
          routes.map(() => (
            <g class="photo-map__boat" data-boat>
              <path d="M0 -15 L0 1 L10 1 Z" />
              <path class="photo-map__boat-jib" d="M-1.5 -12 L-1.5 1 L-8 1 Z" />
              <path d="M-12 4 L12 4 L8 9 L-8 9 Z" />
            </g>
          ))
        }
        <path class="photo-map__outline" d={path(sphere)} data-sphere data-outline></path>
      </svg>

      <ol class="photo-map__pins">
        {
          pins.map((pin, index) => (
            <li
              class:list={['photo-map__pin', { 'is-hidden': pin.hidden }]}
              style={`left: ${pin.left.toFixed(2)}%; top: ${pin.top.toFixed(2)}%; --stagger-index: ${index}`}
              data-pin={pin.id}
              data-lng={pin.lng}
              data-lat={pin.lat}
              data-flip-x={pin.flipX ? '' : undefined}
              data-flip-y={pin.flipY ? '' : undefined}
            >
              <a
                class="photo-map__pin-link"
                href={pin.url}
                aria-label={`${pin.title}, ${pin.place}`}
                tabindex={pin.hidden ? -1 : undefined}
              >
                <span class="photo-map__dot" aria-hidden="true" />
                <span class="photo-map__card" aria-hidden="true">
                  {pin.cardImage && (
                    <img
                      class="photo-map__card-image"
                      src={pin.cardImage}
                      alt=""
                      width="480"
                      height="320"
                      loading="lazy"
                      decoding="async"
                      style={pin.focus}
                    />
                  )}
                  <span class="photo-map__card-body">
                    <span class="photo-map__card-title">{pin.title}</span>
                    <span class="photo-map__card-meta">{pin.place}</span>
                    <span class="photo-map__card-meta">{pin.coords}</span>
                  </span>
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="photo-map__toolbar">
      <p class="photo-map__hint">
        <span class="photo-map__hint-fine">Drag to turn · ctrl + scroll or +/− to zoom</span>
        <span class="photo-map__hint-touch">Swipe sideways to turn · pinch or +/− to zoom</span>
      </p>
      <div class="photo-map__controls">
        <button type="button" class="photo-map__control" data-zoom="in" aria-label="Zoom in">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>
        </button>
        <button type="button" class="photo-map__control" data-zoom="out" aria-label="Zoom out">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14"></path></svg>
        </button>
        <button
          type="button"
          class="photo-map__control"
          data-home
          aria-label="Back to the starting view"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true"
            ><path d="M4 12a8 8 0 1 0 2.3-5.6M4 4v4h4"></path></svg
          >
        </button>
      </div>
    </div>
  </div>

  <ol class="photo-map__index">
    {
      pins.map(pin => (
        <li class="photo-map__entry" data-pin-target={pin.id}>
          <button
            type="button"
            class="photo-map__locate"
            data-locate={pin.id}
            aria-label={`Show ${pin.title} on the globe`}
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="7" />
              <path d="M12 2v4M12 18v4M2 12h4M18 12h4" />
            </svg>
            <span class="photo-map__entry-number">{pin.number}</span>
          </button>
          <a class="photo-map__entry-link" href={pin.url}>
            {pin.thumbnail && (
              <img
                class="photo-map__entry-image"
                src={pin.thumbnail}
                alt=""
                width="192"
                height="128"
                loading="lazy"
                decoding="async"
                style={pin.focus}
              />
            )}
            <span class="photo-map__entry-text">
              <span class="photo-map__entry-title">{pin.title}</span>
              <span class="photo-map__entry-place">{pin.place}</span>
            </span>
            <span class="photo-map__entry-meta">
              <span>{pin.coords}</span>
              <span>
                {pin.kind} · {pin.year}
              </span>
            </span>
          </a>
        </li>
      ))
    }
  </ol>
</figure>

<script is:inline>
  // Hide the globe's drawing until the intro starts, so it doesn't flash fully drawn first.
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document
      .querySelectorAll('[data-photo-map]:not([data-ready])')
      .forEach(el => el.classList.add('is-pending'));
  }
</script>

<script>
  import { animate, createDrawable, createTimeline, spring, stagger, utils } from 'animejs';
  import {
    HOME,
    MAX_ZOOM,
    MIN_ZOOM,
    SIZE,
    alongRoute,
    facing,
    graticule,
    land,
    pathFor,
    projection,
    sphere,
    type LngLat,
  } from '../scripts/globe';

  // degrees of longitude per millisecond while the globe turns on its own: a turn every 90 s
  const SPIN = 360 / 90000;
  // fastest coast after a flick, in degrees per ms
  const MAX_COAST = 0.25;
  const clamp = (value: number, min: number, max: number) => Math.min(max, Math.max(min, value));

  // undone before Astro swaps in the next page
  let cleanups: (() => void)[] = [];

  function setupGlobe(root: HTMLElement) {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const stage = root.querySelector<HTMLElement>('[data-stage]')!;
    const svg = stage.querySelector('svg')!;
    const sphereEls = Array.from(svg.querySelectorAll<SVGPathElement>('[data-sphere]'));
    const graticuleEl = svg.querySelector<SVGPathElement>('[data-graticule]')!;
    const landEl = svg.querySelector<SVGPathElement>('[data-land]')!;
    const routes = Array.from(svg.querySelectorAll<SVGPathElement>('[data-route]')).map(el => ({
      el,
      coordinates: JSON.parse(el.dataset.route!) as LngLat[],
    }));
    const boats = Array.from(svg.querySelectorAll<SVGGElement>('[data-boat]'));
    const pins = Array.from(root.querySelectorAll<HTMLElement>('[data-pin]')).map(el => ({
      el,
      link: el.querySelector('a')!,
      at: [Number(el.dataset.lng), Number(el.dataset.lat)] as LngLat,
    }));

    const view = { lng: HOME[0], lat: HOME[1], zoom: 1 };
    const voyage = { t: 1 };
    let spinning = !reduceMotion;
    let hovering = false;
    let onScreen = true;
    let velocity = 0; // degrees of longitude per ms, left over from a flick

    // ---- drawing ----

    let frame = 0;
    let globeDirty = false;

    function render() {
      frame = 0;
      const center: LngLat = [view.lng, view.lat];
      const project = projection(center, view.zoom);

      if (globeDirty) {
        globeDirty = false;
        const path = pathFor(center, view.zoom);
        const spherePath = path(sphere) ?? '';
        sphereEls.forEach(el => el.setAttribute('d', spherePath));
        graticuleEl.setAttribute('d', path(graticule) ?? '');
        landEl.setAttribute('d', path(land) ?? '');
        routes.forEach(({ el, coordinates }) =>
          el.setAttribute('d', path({ type: 'LineString', coordinates }) ?? '')
        );
        pins.forEach(({ el, link, at }) => {
          const [x, y] = project(at) ?? [0, 0];
          const left = (x / SIZE) * 100;
          const top = (y / SIZE) * 100;
          // behind the globe, or pushed off the edge by zooming in
          const shown = facing(center, at) && left > 0 && left < 100 && top > 0 && top < 100;
          el.style.left = `${left}%`;
          el.style.top = `${top}%`;
          el.classList.toggle('is-hidden', !shown);
          link.tabIndex = shown ? 0 : -1;
          el.toggleAttribute('data-flip-x', left > 60);
          el.toggleAttribute('data-flip-y', top > 55);
        });
      }

      // the boats move on their own, so they're redrawn without the (heavier) globe
      routes.forEach(({ coordinates }, i) => {
        const at = alongRoute(coordinates, voyage.t);
        const [x, y] = project(at) ?? [0, 0];
        boats[i]?.setAttribute('transform', `translate(${x.toFixed(1)} ${y.toFixed(1)})`);
        boats[i]?.classList.toggle('is-hidden', !facing(center, at));
      });
    }

    const draw = () => {
      globeDirty = true;
      if (!frame) frame = requestAnimationFrame(render);
    };
    const drawBoats = () => {
      if (!frame) frame = requestAnimationFrame(render);
    };

    // ---- turning on its own, and coasting after a flick ----

    let loop = 0;
    let last = 0;
    let lastDrawn = 0;
    const stopSpinning = () => {
      spinning = false;
    };

    function tick(now: number) {
      const dt = last ? Math.min(now - last, 50) : 16;
      last = now;
      let moving = false;
      if (Math.abs(velocity) > 0.0005) {
        view.lng += velocity * dt;
        velocity *= Math.pow(0.92, dt / 16);
        moving = true;
      } else {
        velocity = 0;
      }
      if (spinning && !hovering && !drag && onScreen) {
        view.lng -= SPIN * dt;
        moving = true;
      }
      // turning on its own is slow enough that 30 redraws a second look smooth
      if (moving && (velocity || now - lastDrawn >= 32)) {
        lastDrawn = now;
        draw();
      }
      loop = moving ? requestAnimationFrame(tick) : 0;
      if (!moving) last = 0;
    }
    const wake = () => {
      if (!loop) loop = requestAnimationFrame(tick);
    };

    // ---- flying to a place, zooming ----

    function flyTo([lng, lat]: LngLat, zoom = view.zoom) {
      stopSpinning();
      velocity = 0;
      // the short way round
      const target = view.lng + ((((lng - view.lng) % 360) + 540) % 360) - 180;
      if (reduceMotion) {
        Object.assign(view, { lng: target, lat: clamp(lat, -80, 80), zoom });
        draw();
        return;
      }
      animate(view, {
        lng: target,
        lat: clamp(lat, -80, 80),
        zoom,
        duration: 1200,
        ease: 'inOutCubic',
        onUpdate: draw,
      });
    }

    function zoomTo(zoom: number) {
      stopSpinning();
      zoom = clamp(zoom, MIN_ZOOM, MAX_ZOOM);
      if (reduceMotion) {
        view.zoom = zoom;
        draw();
        return;
      }
      animate(view, { zoom, duration: 350, ease: 'outQuad', onUpdate: draw });
    }

    root
      .querySelector('[data-zoom="in"]')
      ?.addEventListener('click', () => zoomTo(view.zoom * 1.6));
    root
      .querySelector('[data-zoom="out"]')
      ?.addEventListener('click', () => zoomTo(view.zoom / 1.6));
    root.querySelector('[data-home]')?.addEventListener('click', () => flyTo(HOME, 1));

    // ---- dragging, pinching ----

    const pointers = new Map<number, { x: number; y: number }>();
    let drag: {
      x: number;
      y: number;
      lng: number;
      lat: number;
      lastX: number;
      lastT: number;
    } | null = null;
    let pinch: { distance: number; zoom: number } | null = null;
    // dragging across the globe's radius turns it about a radian, as if holding the surface
    const degreesPerPixel = () => 180 / Math.PI / ((480 * view.zoom * stage.clientWidth) / SIZE);
    const spread = () => {
      const [a, b] = Array.from(pointers.values());
      return Math.hypot(a.x - b.x, a.y - b.y);
    };

    stage.addEventListener('pointerdown', event => {
      if ((event.target as Element).closest('a, button')) return;
      stopSpinning();
      utils.remove(view);
      velocity = 0;
      pointers.set(event.pointerId, { x: event.clientX, y: event.clientY });
      stage.setPointerCapture(event.pointerId);
      if (pointers.size === 2) {
        pinch = { distance: spread(), zoom: view.zoom };
        drag = null;
      } else {
        drag = {
          x: event.clientX,
          y: event.clientY,
          lng: view.lng,
          lat: view.lat,
          lastX: event.clientX,
          lastT: event.timeStamp,
        };
      }
    });

    stage.addEventListener('pointermove', event => {
      if (!pointers.has(event.pointerId)) return;
      pointers.set(event.pointerId, { x: event.clientX, y: event.clientY });
      if (pinch && pointers.size === 2) {
        view.zoom = clamp((pinch.zoom * spread()) / pinch.distance, MIN_ZOOM, MAX_ZOOM);
        draw();
        return;
      }
      if (!drag) return;
      const k = degreesPerPixel();
      view.lng = drag.lng - (event.clientX - drag.x) * k;
      // on touch screens an up/down swipe scrolls the page, so only sideways turns the globe
      if (event.pointerType !== 'touch') {
        view.lat = clamp(drag.lat + (event.clientY - drag.y) * k, -80, 80);
      }
      // flick speed over the last few frames, capped so a fast flick coasts for a moment, not ages
      const dt = event.timeStamp - drag.lastT;
      if (dt >= 8) {
        velocity = clamp((-(event.clientX - drag.lastX) * k) / dt, -MAX_COAST, MAX_COAST);
        drag.lastX = event.clientX;
        drag.lastT = event.timeStamp;
      }
      draw();
    });

    const release = (event: PointerEvent) => {
      pointers.delete(event.pointerId);
      if (pointers.size < 2) pinch = null;
      if (pointers.size > 0) return;
      // no coasting if the pointer stopped before letting go
      if (!drag || event.timeStamp - drag.lastT > 80) velocity = 0;
      drag = null;
      wake();
    };
    stage.addEventListener('pointerup', release);
    stage.addEventListener('pointercancel', release);

    // a trackpad pinch arrives as ctrl + wheel; a plain wheel keeps scrolling the page
    stage.addEventListener(
      'wheel',
      event => {
        if (!event.ctrlKey) return;
        event.preventDefault();
        stopSpinning();
        view.zoom = clamp(view.zoom * Math.exp(-event.deltaY * 0.01), MIN_ZOOM, MAX_ZOOM);
        draw();
      },
      { passive: false }
    );

    stage.addEventListener('keydown', event => {
      const turns: Record<string, [number, number]> = {
        ArrowLeft: [-20, 0],
        ArrowRight: [20, 0],
        ArrowUp: [0, 15],
        ArrowDown: [0, -15],
      };
      if (turns[event.key]) {
        event.preventDefault();
        const [dLng, dLat] = turns[event.key];
        flyTo([view.lng + dLng, view.lat + dLat]);
      } else if (event.key === '+' || event.key === '=') {
        zoomTo(view.zoom * 1.6);
      } else if (event.key === '-') {
        zoomTo(view.zoom / 1.6);
      }
    });

    // hold still under the mouse so a pin doesn't slide away from the pointer
    stage.addEventListener('pointerenter', event => {
      if (event.pointerType === 'mouse') hovering = true;
    });
    stage.addEventListener('pointerleave', () => {
      hovering = false;
      wake();
    });

    // no turning while scrolled out of view
    const visibility = new IntersectionObserver(([entry]) => {
      onScreen = entry.isIntersecting;
      if (onScreen) wake();
    });
    visibility.observe(stage);

    // ---- pins and the list of places ----

    const pinFor = (id: string | undefined) => pins.find(pin => pin.el.dataset.pin === id);
    const setActive = (active?: HTMLElement) => {
      pins.forEach(({ el }) => el.classList.toggle('is-active', el === active));
    };
    let lastPointer = 'mouse';

    // On touch screens the first tap on a pin shows its preview, the second follows the link.
    pins.forEach(({ el, link }) => {
      const card = el.querySelector<HTMLElement>('.photo-map__card');
      link.addEventListener('pointerdown', event => {
        lastPointer = event.pointerType;
      });
      link.addEventListener('click', event => {
        const cardShown = card && getComputedStyle(card).display !== 'none';
        if (lastPointer === 'touch' && cardShown && !el.classList.contains('is-active')) {
          event.preventDefault();
          setActive(el);
        }
      });
    });
    root.addEventListener('click', event => {
      if (!(event.target as Element).closest('[data-pin]')) setActive();
    });

    root.querySelectorAll<HTMLElement>('[data-pin-target]').forEach(entry => {
      const pin = pinFor(entry.dataset.pinTarget);
      if (!pin) return;
      // hovering an entry highlights its pin
      entry.addEventListener('pointerenter', () => pin.el.classList.add('is-highlighted'));
      entry.addEventListener('pointerleave', () => pin.el.classList.remove('is-highlighted'));
      entry.addEventListener('focusin', () => pin.el.classList.add('is-highlighted'));
      entry.addEventListener('focusout', () => pin.el.classList.remove('is-highlighted'));
      // the locate button turns the globe to it
      entry.querySelector('[data-locate]')?.addEventListener('click', () => {
        flyTo(pin.at);
        const box = stage.getBoundingClientRect();
        if (box.bottom < 0 || box.top > window.innerHeight) {
          stage.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'center' });
        }
      });
    });

    // ---- the intro, then the boats ----

    function sail() {
      if (reduceMotion || !boats.length) return;
      root.classList.add('is-sailing');
      animate(voyage, {
        t: [0, 1],
        duration: 9000,
        ease: 'inOutSine',
        loop: true,
        loopDelay: 2000,
        onUpdate: drawBoats,
      });
    }

    if (root.classList.contains('is-pending')) {
      // The outline draws itself while the globe rolls round into view, then the
      // routes draw, the pins drop in and the boats set off.
      view.lng = HOME[0] + 110;
      draw();
      render();
      const outline = createDrawable(svg.querySelector<SVGPathElement>('[data-outline]')!);
      const routeLines = createDrawable(routes.map(route => route.el));
      const pinLinks = pins.map(pin => pin.link);
      utils.set([landEl, graticuleEl], { opacity: 0 });
      utils.set(pinLinks, { opacity: 0, translateY: -18, scale: 0.4 });
      root.classList.remove('is-pending');

      const intro = createTimeline({
        onComplete: () => {
          wake();
          sail();
        },
      })
        .add(outline, { draw: ['0 0', '0 1'], duration: 1100, ease: 'inOutSine' }, 0)
        .add([landEl, graticuleEl], { opacity: [0, 1], duration: 1200, ease: 'outQuad' }, 300)
        .add(view, { lng: HOME[0], duration: 2600, ease: 'outCubic', onUpdate: draw }, 0)
        .add(routeLines, { draw: ['0 0', '0 1'], duration: 1600, ease: 'inOutSine' }, 1600)
        .add(
          pinLinks,
          {
            opacity: [0, 1],
            translateY: [-18, 0],
            scale: [0.4, 1],
            delay: stagger(160),
            ease: spring({ bounce: 0.45, duration: 700 }),
          },
          1800
        );
      cleanups.push(() => intro.pause());
    } else {
      draw();
      wake();
    }

    cleanups.push(() => {
      cancelAnimationFrame(frame);
      cancelAnimationFrame(loop);
      utils.remove([view, voyage]);
      visibility.disconnect();
    });
  }

  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('[data-photo-map]').forEach(root => {
      if (root.dataset.ready === 'true') return;
      root.dataset.ready = 'true';
      setupGlobe(root);
    });
  });
  document.addEventListener('astro:before-swap', () => {
    cleanups.forEach(cleanup => cleanup());
    cleanups = [];
  });
</script>

<style>
  .photo-map {
    /* the body is a wrapping flex column, which measures items at their narrowest width;
       without a definite width the map's height is undercounted and the footer overlaps the index */
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    gap: 2.5rem;
    color: inherit;
  }

  @media (min-width: 1024px) {
    .photo-map {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      align-items: center;
    }
  }

  .photo-map__globe {
    display: grid;
    justify-items: center;
    gap: 0.75rem;
  }

  .photo-map__stage {
    position: relative;
    width: 100%;
    max-width: 640px;
    /* sideways swipes turn the globe; up/down swipes still scroll the page */
    touch-action: pan-y;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
    border-radius: 50%;
  }

  .photo-map__stage:active {
    cursor: grabbing;
  }

  .photo-map__stage:focus-visible {
    outline: 1px dashed currentColor;
    outline-offset: 6px;
  }

